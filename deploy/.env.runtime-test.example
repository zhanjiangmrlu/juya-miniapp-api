# Copy to /etc/juya/miniapp-api.env, chmod 600; never commit real secrets.
# Reuse the existing TEST database and application password; do not create a new volume.
JUYA_DATABASE_URL=mysql+asyncmy://juya_admin_app:replace-with-existing-test-app-password@mysql:3306/juya
JUYA_LOG_LEVEL=INFO
# Must match admin API, admin worker/beat and miniapp API/worker/beat.
JUYA_INTERNAL_HMAC_SECRET=replace-with-existing-shared-secret-at-least-32-random-bytes
JUYA_JWT_SECRET=replace-with-independent-random-secret
JUYA_JWT_KEY_ID=v1
# URL-safe Base64 of 32 random bytes; keep stable after data is written.
JUYA_FIELD_ENCRYPTION_KEY_BASE64=replace-with-valid-url-safe-base64
JUYA_FIELD_LOOKUP_KEY=replace-with-independent-random-secret
JUYA_WECHAT_APP_ID=replace-with-test-miniapp-appid
JUYA_WECHAT_APP_SECRET=replace-with-wechat-app-secret
JUYA_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
JUYA_OSS_REGION=cn-shenzhen
JUYA_OSS_BUCKET=juya-test
JUYA_OSS_CREDENTIALS_MODE=ecs_ram_role
JUYA_OSS_RAM_ROLE_NAME=replace-with-existing-ecs-ram-role-name
JUYA_CONTENT_SECURITY_ENABLED=false
