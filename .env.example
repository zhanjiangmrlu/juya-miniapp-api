JUYA_ENVIRONMENT=local
JUYA_LOCAL_DEV_MODE=false
# Disabled in local, test and production. Set true to restore feedback text review.
JUYA_CONTENT_SECURITY_ENABLED=false
JUYA_DATABASE_URL=mysql+asyncmy://juya:juya-dev@mysql:3306/juya
JUYA_REDIS_URL=redis://redis:6379/0
JUYA_ADMIN_API_BASE_URL=http://juya-admin-api:8000
JUYA_INTERNAL_HMAC_SECRET=replace-me
JUYA_JWT_SECRET=replace-me
JUYA_JWT_KEY_ID=v1
JUYA_FIELD_ENCRYPTION_KEY_BASE64=replace-with-base64-key
JUYA_FIELD_LOOKUP_KEY=replace-me
JUYA_WECHAT_APP_ID=replace-me
JUYA_WECHAT_APP_SECRET=replace-me
JUYA_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
JUYA_OSS_REGION=cn-shenzhen
JUYA_OSS_BUCKET=juya-test
JUYA_OSS_EXPECTED_BUCKET=juya-test
JUYA_OSS_CREDENTIALS_MODE=environment
JUYA_OSS_RAM_ROLE_NAME=
# Set credentials in the server environment only, never in VITE_* or Git.
JUYA_OSS_ACCESS_KEY_ID=
JUYA_OSS_ACCESS_KEY_SECRET=
# STS users also supply an aware expiration time.
# JUYA_OSS_SESSION_TOKEN=
# JUYA_OSS_CREDENTIALS_EXPIRES_AT=2026-10-01T00:00:00Z
